# Copy to .env and set your Jira Personal Access Token
JIRA_SERVER=https://jira.disney.com
JIRA_TOKEN=your_personal_access_token_here

# For GitHub Actions auto-sync, add the same values as repository secrets:
#   JIRA_TOKEN (required), JIRA_SERVER (optional)

# Optional: basic auth instead of PAT
# JIRA_USERNAME=your_username
# JIRA_PASSWORD=your_password_or_token
